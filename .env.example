# Frontend / CMS integration
CMS_ENABLED=1
CMS_LANGUAGE=fa
CMS_REVALIDATE_SECONDS=30
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Docker PostgreSQL
POSTGRES_DB=beautypay
POSTGRES_USER=beautypay
POSTGRES_PASSWORD=beautypay

# Django CMS
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,cms
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
